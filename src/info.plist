				<key>script</key>
				<string>PATH_TO_OPEN="$1"

# Remove trailing slash if any
PATH_TO_OPEN="${PATH_TO_OPEN%/}"

if [ -f "$PATH_TO_OPEN" ]; then
    # It's a file → open its containing folder
    PATH_TO_OPEN="$(dirname "$PATH_TO_OPEN")"
fi

# Warn instead of opening a window in the wrong place when the target is gone
# or blocked by macOS privacy (TCC), e.g. app group containers like Notes.
if [ ! -d "$PATH_TO_OPEN" ]; then
    osascript -e 'display notification "Path no longer exists." with title "Finder Bookmarks"'
    exit 0
fi
if ! /bin/ls "$PATH_TO_OPEN" > /dev/null 2> /dev/null; then
    osascript -e 'display notification "Folder is protected by macOS. Grant Ghostty Full Disk Access to open it here." with title "Finder Bookmarks"'
    exit 0
fi

# Use Ghostty's AppleScript API (`open -a Ghostty &lt;dir&gt;` crashes Ghostty 1.3.1).
# The path goes in as an argv argument so quotes in it cannot break the script.
osascript -e 'on run argv' \
    -e 'tell application "Ghostty"' \
    -e 'set cfg to new surface configuration' \
    -e 'set initial working directory of cfg to item 1 of argv' \
    -e 'new window with configuration cfg' \
    -e 'activate' \
    -e 'end tell' \
    -e 'end run' "$PATH_TO_OPEN"</string>
