				<string>PATH_TO_OPEN="$1"

# Remove trailing slash if any
PATH_TO_OPEN="${PATH_TO_OPEN%/}"

if [ -d "$PATH_TO_OPEN" ]; then
    # It's a folder → open there
    wezterm start --cwd "$PATH_TO_OPEN"
elif [ -f "$PATH_TO_OPEN" ]; then
    # It's a file → open its containing folder
    FILE_DIR="$(dirname "$PATH_TO_OPEN")"
    wezterm start --cwd "$FILE_DIR"
else
    echo "Invalid path: $PATH_TO_OPEN"
fi</string>
