				<key>script</key>
				<string>PATH_TO_OPEN="$1"

# Pass the path as an argv argument so quotes/backslashes in it cannot
# break or inject into the AppleScript source
if [ -d "$PATH_TO_OPEN" ]; then
    # Folder bookmark: open the folder itself in Finder
    osascript -e 'on run argv' -e 'tell application "Finder"' -e 'open (POSIX file (item 1 of argv) as alias)' -e 'activate' -e 'end tell' -e 'end run' "$PATH_TO_OPEN"
elif [ -f "$PATH_TO_OPEN" ]; then
    # File bookmark: reveal file in its parent folder
    osascript -e 'on run argv' -e 'tell application "Finder"' -e 'reveal (POSIX file (item 1 of argv) as alias)' -e 'activate' -e 'end tell' -e 'end run' "$PATH_TO_OPEN"
else
    echo "Invalid path: $PATH_TO_OPEN" &gt;&amp;2
fi</string>
